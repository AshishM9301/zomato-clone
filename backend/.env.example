# --- Server ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
SERVICE_NAME=zomato-clone-backend

# --- Auth ---
# Used to sign JWTs. Replace before any non-local deploy.
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- PostgreSQL ---
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=zomato_clone
PG_POOL_MAX=10
PG_POOL_IDLE_MS=30000

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=zclone:

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Seed (dev only) ---
# Optional override for the seeded admin password (default 'admin123').
# SEED_ADMIN_PASSWORD=